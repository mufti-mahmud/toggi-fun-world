# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (used for WhatsApp webhook registration).
APP_URL="MY_APP_URL"

# SITE_PASSWORD: Required in production. Everyone must enter it before the portal loads.
# Use a long passphrase. Changing it signs every device out.
SITE_PASSWORD=
# SESSION_SECRET: Optional. Overrides the key used to sign login cookies (default: derived from SITE_PASSWORD).
SESSION_SECRET=

# TICKET_API_KEY: Key for machine clients (e.g. the .NET ticket client) calling /api/ticket-sales without a login.
# Send it as "x-api-key: <key>" or "Authorization: Bearer <key>". Leave empty to disable key access.
TICKET_API_KEY=

# WhatsApp alerts. Tokens are read only from here, never from the database.
WHAPI_API_URL="https://gate.whapi.cloud/"
WHAPI_API_TOKEN=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# WHATSAPP_WEBHOOK_SECRET: Optional. When set, /api/webhooks/whatsapp requires ?secret=<value>.
WHATSAPP_WEBHOOK_SECRET=
# With a Green API token set, the server reads new group messages (nightly sales report, technician replies) at
# startup and then every WHATSAPP_POLL_INTERVAL_MINUTES (default 120, minimum 5). Green API's free Developer plan
# allows 1,000 reads a month, so keep the default there; a webhook to this server delivers messages instantly.
# Set WHATSAPP_POLL_DISABLED=1 to stop polling entirely.
WHATSAPP_POLL_INTERVAL_MINUTES=
WHATSAPP_POLL_DISABLED=

# BACKUP_PASSWORD: Required for Admin > Cloud Database & Backup (download and restore).
# Keep it separate from SITE_PASSWORD and the admin role password; give it only to the main admin.
BACKUP_PASSWORD=

# Activity log (data/activity-log.db): every data change, user action, WhatsApp event, error and a health sample.
# Download a day at /api/activity-log?date=YYYY-MM-DD&format=csv (summary: /api/activity-log/summary?date=...).
ACTIVITY_LOG_RETENTION_DAYS=
ACTIVITY_LOG_HEALTH_SECONDS=
